{
  "name": "keyflap",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project unit-isolated",
    "test:e2e": "vitest run --project e2e",
    "test:isolation": "vitest run --config packages/isolation/vitest.config.ts",
    "check:escapes": "node scripts/check-escapes.mjs",
    "check:comments": "node scripts/check-comments.ts",
    "check:bidi": "node scripts/check-bidi.ts",
    "check:static": "node scripts/run-parallel.ts typecheck lint check:escapes check:comments check:bidi",
    "check": "pnpm check:static && pnpm test",
    "hooks:install": "git config core.hooksPath .githooks",
    "test-rp": "node packages/test-rp/src/main.ts",
    "keyflap": "node packages/cli/src/main.ts",
    "setup:preview": "node packages/cli/test/setup-preview.ts",
    "console:preview": "node packages/cli/test/console-preview.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

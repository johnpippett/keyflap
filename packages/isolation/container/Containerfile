# Throwaway machine for the service-mode isolation tests (packages/isolation).
# systemd runs as PID 1 so the real units, sockets and LoadCredentialEncrypted= are
# exercised. Nothing from the repo is baked in: the test mounts the worktree read-only
# and runs the installer inside a fresh container every time.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# systemd + the tools the probe uses (python3 for ptrace(2)), plus the shared libraries
# Playwright's Chromium 1248 needs on Ubuntu 24.04 (headless shell and the full build).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus ca-certificates xz-utils procps iproute2 python3 sudo \
      libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 \
      libcups2t64 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 libnspr4 libnss3 \
      libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
      libxkbcommon0 libxrandr2 libfontconfig1 libfreetype6 fonts-liberation xvfb \
 && rm -rf /var/lib/apt/lists/* \
 # Units a container doesn't need (and that fail or stall without a real machine).
 && systemctl mask systemd-logind.service getty.target console-getty.service \
      systemd-udevd.service systemd-udev-trigger.service systemd-firstboot.service \
      systemd-resolved.service systemd-networkd.service apt-daily.timer \
      apt-daily-upgrade.timer e2scrub_reap.service \
 # The "user" whose agent we defend against: an ordinary uid, not root, not a service user.
 && useradd --create-home --uid 1500 --shell /bin/bash agentuser

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
